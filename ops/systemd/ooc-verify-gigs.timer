[Unit]
Description=Trigger OOC verify-gigs daily, 02:00 local
# Deliberately no Requires=<service>: in [Unit] that means "start the service
# when the timer starts", firing a spurious run at every boot. Unit= in
# [Timer] is what binds the two. (2026-08-06)

[Timer]
OnCalendar=*-*-* 02:00:00
RandomizedDelaySec=30min
Persistent=true
Unit=ooc-verify-gigs.service

[Install]
WantedBy=timers.target
