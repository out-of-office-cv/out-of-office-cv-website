[Unit]
Description=Out of Office CV: find new gigs (agent /find-gigs + open PR)
Documentation=file:///home/ben/projects/out-of-office-cv-website-cron/cron-find-gigs.sh
# No `After=network-online.target` here: that is a system target, so in the
# user manager it silently resolves to nothing and orders nothing. The real
# guard is the ExecStartPre below. (2026-07-27)

[Service]
Type=oneshot
ExecStartPre=/home/ben/.dotfiles/bin/wait-for-network
WorkingDirectory=/home/ben/projects/out-of-office-cv-website-cron
Environment=PATH=/home/ben/.local/share/mise/shims:/home/ben/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ben/projects/out-of-office-cv-website-cron/cron-find-gigs.sh
TimeoutStartSec=2h
