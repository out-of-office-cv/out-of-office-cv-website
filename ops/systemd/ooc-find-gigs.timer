[Unit]
Description=Trigger OOC find-gigs daily, 05:00 local
# Deliberately no Requires=<service>: in [Unit] that means "start the service
# when the timer starts", firing a spurious run at every boot. Unit= in
# [Timer] is what binds the two. (2026-08-06)

[Timer]
OnCalendar=*-*-* 05:00:00
RandomizedDelaySec=30min
Persistent=true
Unit=ooc-find-gigs.service

[Install]
WantedBy=timers.target
